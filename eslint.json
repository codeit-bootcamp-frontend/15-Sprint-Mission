{
  "env": {
    "browser": true, // 브라우저 환경에서 실행되는 코드로 설정
    "node": true, // Node.js 환경에서 실행되는 코드로 설정
    "es6": true // ES6 문법 사용을 허용
  },
  "extends": [
    "eslint:recommended", // ESLint에서 추천하는 기본 규칙을 포함
    "plugin:prettier/recommended" // Prettier와 충돌하지 않도록 설정 (Prettier와 ESLint를 함께 사용할 경우)
  ],
  "parserOptions": {
    "ecmaVersion": 2020, // ECMAScript 2020 문법을 지원하도록 설정
    "sourceType": "module" // ES 모듈을 사용한다고 설정 (import/export 사용)
  },
  "rules": {
    "semi": ["error", "always"], // 세미콜론을 항상 사용하도록 설정
    "quotes": ["error", "single"], // 작은따옴표(single quotes)를 사용하도록 설정
    "no-console": "warn", // console.log를 사용하지 않도록 경고를 표시
    "no-unused-vars": "warn" // 사용되지 않은 변수에 대해 경고를 표시
  }
}
